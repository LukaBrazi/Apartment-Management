# --- Package manager discipline ---
# This project uses npm (see Dockerfile → `npm ci`).
# Do not commit other package managers' lockfiles — they cause install-time drift
# between local dev and the Docker-based CI pipeline.
yarn.lock
pnpm-lock.yaml

