# ═══════════════════════════════════════════════════════════
# RAILWAY — Backend environment variables
# Додай ці змінні в Railway → Service → Variables
# ═══════════════════════════════════════════════════════════

DJANGO_SETTINGS_MODULE=config.settings.production

# Згенеруй: python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
DJANGO_SECRET_KEY=

# Railway subdomain + твій кастомний домен (якщо є)
# Приклад: sckandi-apartments.up.railway.app,api.skandi.com
DJANGO_ALLOWED_HOSTS=

# Vercel URL + Railway URL (для CSRF)
# Приклад: https://sckandi.vercel.app,https://sckandi-apartments.up.railway.app
CSRF_TRUSTED_ORIGINS=

# Vercel URL (для CORS)
# Приклад: https://sckandi.vercel.app
CORS_ALLOWED_ORIGINS=

# Railway додає автоматично при підключенні PostgreSQL plugin
DATABASE_URL=

# Railway додає автоматично при підключенні Redis plugin
REDIS_URL=

# ── Cloudflare R2 ────────────────────────────────────────
# 1. cloudflare.com → R2 → Create bucket → назви "skandi-apartments"
# 2. R2 → Manage R2 API tokens → Create API token (Object Read & Write)
# 3. Account ID знайдеш в правому sidebar на головній сторінці R2

R2_BUCKET_NAME=skandi-apartments
R2_ENDPOINT_URL=https://<ACCOUNT_ID>.r2.cloudflarestorage.com
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
# R2 → bucket → Settings → Public access → Enable → скопіюй URL
R2_PUBLIC_URL=https://pub-<hash>.r2.dev

# ── Email (Resend — безкоштовно 3000 листів/міс) ─────────
# resend.com → API Keys → SMTP credentials
EMAIL_HOST=smtp.resend.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=resend
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=noreply@skandi-apartments.com

# Google OAuth (опційно)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=


# ═══════════════════════════════════════════════════════════
# VERCEL — Frontend environment variables
# Додай в Vercel → Project → Settings → Environment Variables
# ═══════════════════════════════════════════════════════════

# Railway URL твого backend (без слешу в кінці)
# Приклад: https://sckandi-apartments.up.railway.app
NEXT_PUBLIC_API_URL=
